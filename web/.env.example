# Copia este archivo a .env.local y completa los valores
# NUNCA subas .env.local a Git

# Clave API de Anthropic (Claude) — requerida para:
#   · Estimador de Rehabilitación (visión)
#   · Generador de Contratos
#   · Generador de Cartas Directas
#   · Constructor de Scripts de Llamadas
ANTHROPIC_API_KEY=sk-ant-TUCLAVEAQUI

# Modelo Claude (opcional; default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5
