# Copy this file to .env and fill in your own values.
# Generate the bcrypt hash with:  npm run hash -- 'your-password'

PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Long random string used to sign session cookies. Regenerate on first run.
# Easy generator:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-string

# Set to "true" if served behind HTTPS (sets the Secure cookie flag).
SECURE_COOKIES=false

# Max ZIP upload size in megabytes.
MAX_UPLOAD_MB=500
